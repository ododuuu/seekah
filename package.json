{
  "name": "seekah",
  "version": "0.40.0",
  "private": true,
  "description": "Local-first document search, context selection, MCP and desktop workbench",
  "type": "module",
  "bin": {
    "seekah": "dist/src/cli.js",
    "docsearch": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node dist/src/cli.js",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "check": "npm run test",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "benchmark:ngram": "npm run build && node scripts/benchmark-ngram.mjs",
    "benchmark:m24": "npm run build && node scripts/benchmark-m24.mjs",
    "benchmark:m27": "npm run build && node scripts/benchmark-m27.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "demo:msg": "npm run build && node scripts/demo-msg.mjs"
  },
  "devDependencies": {
    "@types/node": "22.17.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@kenjiuno/decompressrtf": "0.1.4",
    "@kenjiuno/msgreader": "1.28.0",
    "@modelcontextprotocol/server": "2.0.0",
    "fast-xml-parser": "5.11.1",
    "fflate": "0.8.3",
    "htmlparser2": "12.0.0",
    "iconv-lite": "0.6.3",
    "pdfjs-dist": "6.3.289",
    "postal-mime": "3.0.0",
    "rtf-stream-parser": "3.8.1",
    "word-extractor": "1.0.4",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "4.2.0"
  }
}
